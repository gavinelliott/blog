---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/fonts.css';
import '../styles/global.css';
import { SEO } from 'astro-seo';
import deploymentConfig from '../../vercel.json';

// Use the deployment policy for local previews too. frame-ancestors requires a header.
const contentSecurityPolicy = deploymentConfig.headers[0].headers
  .find(({ key }) => key === 'Content-Security-Policy').value
  .split(';')
  .map(directive => directive.trim())
  .filter(directive => !directive.startsWith('frame-ancestors '))
  .join('; ');

interface Props {
	title: string;
	description: string;
	image?: string;
	article?: boolean;
	publishDate?: Date;
	noindex?: boolean;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { 
	title, 
	description, 
	image = '/images/writing-blog-post-placeholder.jpg',
	article = false,
	publishDate,
	noindex = false
} = Astro.props;

// Current URL for canonical links
const currentUrl = canonicalURL.toString();
---

<meta http-equiv="Content-Security-Policy" content={contentSecurityPolicy} />

<!-- SEO Component -->
<SEO
  title={title}
  noindex={noindex}
  description={description}
  canonical={canonicalURL.toString()}
  openGraph={{
    basic: {
      title: title,
      type: article ? 'article' : 'website',
      image: new URL(image, Astro.url).toString(),
      url: currentUrl,
    },
    optional: {
      description: description,
      siteName: "Gavin Elliott",
      locale: "en_GB",
    },
    image: {
      alt: `Image for ${title}`,
    },
    article: article ? {
      publishedTime: publishDate?.toISOString(),
      authors: ["Gavin Elliott"],
    } : undefined,
  }}
  twitter={{
    card: "summary_large_image",
    site: "@gavinelliott",
    creator: "@gavinelliott",
    title: title,
    description: description,
    image: new URL(image, Astro.url).toString(),
    imageAlt: `Image for ${title}`,
  }}
/>

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href="/favicon.ico" />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="apple-touch-icon" href="/favicon.png" />
<meta name="generator" content={Astro.generator} />

<!-- Accessibility Metadata -->
<meta name="color-scheme" content="light" />
<meta name="theme-color" content="#FFFFF8" />

<link rel="preload" href="/fonts/JTUSjIg69CK48gW7PXoo9WlhyyTh89Y.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/0QIvMX1D_JOuMwr7I_FMl_E.woff2" as="font" type="font/woff2" crossorigin />

<!-- Performance hints for browser - prefetch on hover -->
<script>
document.addEventListener('DOMContentLoaded', () => {
  // Prefetch pages on hover/focus for faster navigation
  const links = document.querySelectorAll('a');
  const prefetched = new Set();
  
  links.forEach(link => {
    if (link.hostname === window.location.hostname) {
      link.addEventListener('mouseenter', () => {
        const href = link.getAttribute('href');
        
        if (href && !prefetched.has(href)) {
          const linkEl = document.createElement('link');
          linkEl.rel = 'prefetch';
          linkEl.href = href;
          document.head.appendChild(linkEl);
          prefetched.add(href);
        }
      });
    }
  });
});
</script>

<!-- Service worker registration -->
<script>
if ('serviceWorker' in navigator) {
  window.addEventListener('load', () => {
    navigator.serviceWorker.register('/sw.js', { updateViaCache: 'none' })
      .then(registration => {
        console.log('Service Worker registered with scope:', registration.scope);
      })
      .catch(error => {
        console.error('Service Worker registration failed:', error);
      });
  });
}
</script>
