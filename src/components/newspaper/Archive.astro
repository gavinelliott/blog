---
import { getCollection } from 'astro:content';
import { topics } from '../../data/topics';
import Layout from './Layout.astro';
const posts = (await getCollection('blog')).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf() || a.id.localeCompare(b.id));
const lead = posts[0];
const years = [...new Set(posts.map(p=>p.data.pubDate.getUTCFullYear()))];
const titles: Record<string,string> = {'ai-and-product-design':'AI & product design','design-leadership':'Design leadership','design-careers':'Design careers'};
const date = (d:Date) => d.toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric',timeZone:'UTC'});
---
<Layout description="Browse the full archive of writing by Gavin Elliott." title="All writing | Gav Elliott">
 <main id="main" tabindex="-1" class="full-archive">
  <nav class="archive-topics" aria-label="Writing topics"><a href="/writing/" aria-current="page">All writing</a>{topics.map(t=><a href={`/writing/${t.slug}/`}>{titles[t.slug]}</a>)}</nav>
  <header class="archive-title"><div><p class="eyebrow">{posts.length} articles · {years[years.length-1]}–{years[0]}</p><h1>All writing<span aria-hidden="true">.</span></h1><p class="archive-intro">I write about design, the things I’m building and what’s going on in my life.</p></div><button class="archive-search" data-open-search>Search the writing <span aria-hidden="true">→</span></button></header>
  {lead && <article class="archive-latest"><p class="eyebrow">Latest article</p><div><p class="archive-date"><time datetime={lead.data.pubDate.toISOString()}>{date(lead.data.pubDate)}</time></p><h2><a href={`/blog/${lead.id}/`}>{lead.data.title}</a></h2><p class="latest-description">{lead.data.description}</p><a class="text-link" href={`/blog/${lead.id}/`}>Read the article <span aria-hidden="true">→</span></a></div></article>}
  <div class="archive-grid">
   <aside class="year-index"><nav aria-label="Browse by year"><h2>By year</h2><ul>{years.map(year=><li><a href={`#year-${year}`}><span>{year}</span><span class="year-count">{posts.filter(p=>p.data.pubDate.getUTCFullYear()===year).length}<span class="sr-only"> articles</span></span></a></li>)}</ul></nav><a class="rss-link" href="/rss.xml">Subscribe via RSS →</a></aside>
   <div class="year-groups">{years.map(year=>{const entries=posts.filter(p=>p.data.pubDate.getUTCFullYear()===year);return <section class="archive-year" aria-labelledby={`year-${year}`}><header><h2 id={`year-${year}`} tabindex="-1">{year}</h2><span>{entries.length} {entries.length===1?'article':'articles'}</span></header><ol>{entries.map(post=><li><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en-GB',{day:'numeric',month:'short',timeZone:'UTC'})}</time><h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3><span class="row-arrow" aria-hidden="true">→</span></li>)}</ol></section>})}</div>
  </div>
  <div class="archive-bottom"><span>{posts.length} articles</span><a href="#main">Back to the top ↑</a></div>
 </main>
</Layout>
<style>
.full-archive .archive-topics{display:flex;flex-wrap:wrap;gap:8px 24px;padding:16px 0}.archive-topics a{font:700 13px/1.4 var(--ui);padding:12px 0;text-decoration:none}.archive-topics a[aria-current]{color:var(--green);text-decoration:underline;text-decoration-thickness:3px;text-underline-offset:7px}.archive-topics a:hover{text-decoration:underline}
.archive-title{background:var(--green);color:var(--paper);padding:30px;display:flex;align-items:end;justify-content:space-between;gap:30px}.archive-title .eyebrow{font-size:12px;letter-spacing:.04em}.archive-title h1{font:400 clamp(42px,7vw,100px)/1.1 var(--display);letter-spacing:-.03em;text-transform:uppercase;text-wrap:balance}.archive-title h1 span{color:var(--yellow)}.archive-intro{max-width:620px;font-size:20px;margin-top:16px;text-wrap:pretty}.archive-search{border:0;background:var(--yellow);color:var(--ink);padding:15px 18px;font:700 14px/1.4 var(--ui);flex-shrink:0;min-height:48px}.archive-search span{margin-left:14px}
.archive-latest{display:grid;grid-template-columns:160px minmax(0,1fr);gap:24px;padding:32px 0;border-bottom:3px solid var(--ink)}.archive-latest>.eyebrow{color:var(--green);padding-top:3px}.archive-date{font:700 12px/1.5 var(--ui);margin-bottom:12px}.archive-latest h2{font:400 clamp(28px,3.4vw,48px)/1.4 var(--display);text-transform:uppercase;letter-spacing:-.015em;max-width:1000px;text-wrap:balance}.archive-latest h2 a{text-decoration:none}.archive-latest h2 a:hover{text-decoration:underline;text-decoration-thickness:2px}.latest-description{max-width:760px;margin:14px 0 12px;font-size:18px;line-height:1.6;text-wrap:pretty}
.archive-grid{display:grid;grid-template-columns:160px minmax(0,1fr);gap:48px;padding:32px 0 40px;align-items:start}.year-index{position:sticky;top:24px;max-height:calc(100dvh - 48px);overflow-y:auto;padding:0 8px 8px 0}.year-index h2{font:700 14px/1.5 var(--ui);text-transform:uppercase;margin-bottom:12px}.year-index ul{list-style:none;margin:0;padding:0;border-top:2px solid var(--ink)}.year-index li{border-bottom:1px solid var(--rule)}.year-index li a{display:flex;justify-content:space-between;align-items:center;gap:15px;padding:12px 8px;min-height:44px;text-decoration:none;font:700 15px/1.4 var(--ui)}.year-index li a:hover{background:var(--yellow);text-decoration:underline}.year-count{font:400 13px var(--serif)}.rss-link{display:inline-block;padding:18px 0;font:700 12px/1.5 var(--ui);color:var(--green)}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
.archive-year{margin-bottom:38px}.archive-year>header{display:flex;align-items:center;justify-content:space-between;gap:20px;border-bottom:2px solid var(--green);padding:0 0 12px}.archive-year h2{font:400 48px/1.1 var(--display);color:var(--green);scroll-margin-top:24px}.archive-year h2:target{background:var(--yellow)}.archive-year header>span{font:700 12px/1.5 var(--ui)}.archive-year ol{list-style:none;padding:0;margin:0}.archive-year li{display:grid;grid-template-columns:72px minmax(0,1fr) 20px;gap:20px;align-items:baseline;padding:20px 0;border-bottom:1px solid var(--rule)}.archive-year time{font:700 12px/1.5 var(--ui);white-space:nowrap;font-variant-numeric:tabular-nums}.archive-year h3{font:400 24px/1.4 var(--serif);letter-spacing:-.015em;word-break:normal;overflow-wrap:normal;hyphens:none}.archive-year h3 a{text-decoration:none;text-decoration-skip-ink:auto}.archive-year h3 a:hover{text-decoration:underline;text-decoration-thickness:from-font}.row-arrow{color:var(--green)}.archive-bottom{border-top:3px solid var(--ink);padding:20px 0;display:flex;justify-content:space-between;gap:20px;font:700 13px/1.5 var(--ui)}
@media(max-width:1000px){.archive-title{align-items:start;flex-direction:column}.archive-grid{grid-template-columns:120px minmax(0,1fr);gap:30px}.archive-latest{grid-template-columns:120px minmax(0,1fr);gap:30px}}
@media(max-width:760px){.archive-topics{gap:4px 18px!important}.archive-topics a{font-size:12px}.archive-title{padding:22px;gap:20px}.archive-intro{font-size:18px}.archive-latest{grid-template-columns:minmax(0,1fr);gap:8px;padding:24px 0}.archive-latest h2{font-size:clamp(25px,6.5vw,38px)}.latest-description{font-size:17px}.archive-grid{grid-template-columns:minmax(0,1fr);gap:28px;padding-top:24px}.year-index{position:static;max-height:none;overflow:visible;padding:0}.year-index ul{display:flex;flex-wrap:wrap;gap:6px;border:0}.year-index li{border:1px solid var(--rule)}.year-index li a{gap:12px;padding:10px 12px}.rss-link{padding-bottom:0}.archive-year h2{font-size:40px}.archive-year li{grid-template-columns:55px minmax(0,1fr);gap:12px;padding:17px 0}.archive-year h3{font-size:21px}.archive-year time{font-size:12px}.row-arrow{display:none}.archive-bottom{font-size:12px}}
</style>
