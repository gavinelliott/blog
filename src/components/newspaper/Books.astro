---
import Layout from './Layout.astro';
import bookSections from '../../data/books.json';
const labels: Record<string,string> = {'service-design-books':'Service design','interaction-product-design-books':'Interaction & product','accessibility-books':'Accessibility','management-and-leadership-books':'Management & leadership','innovation-books':'Innovation'};
const intros: Record<string,string> = {'service-design-books':'Designing services and the organisations behind them.','interaction-product-design-books':'Interfaces, interactions and how people use what we make.','accessibility-books':'Making products and services more accessible.','management-and-leadership-books':'Leading teams and running organisations.','innovation-books':'Design, technology and change.'};
const total = bookSections.reduce((sum,s)=>sum+s.books.length,0);
const covers = [bookSections[1].books[0],bookSections[3].books[0],bookSections[2].books[0]];
---
<Layout description="Books I recommend on design, people and doing good work." title="Recommended books | Gav Elliott">
 <main id="main" tabindex="-1" class="books-edition">
  <header class="books-cover"><div><p class="eyebrow">Recommended reading</p><h1>Books worth<br/>your time<span>.</span></h1><p>Books I’ve found useful on design, leadership and the way we work.</p></div><div class="books-cover-art" aria-hidden="true">{covers.map(book=><img src={book.cover} alt="" width="160" height="230" decoding="async"/>)}</div></header>
  <div class="books-disclosure"><p>These are affiliate links. If you buy through them, I may receive a small commission at no extra cost to you.</p><span>{total} books · {bookSections.length} subjects</span></div>
  <div class="books-body"><nav class="books-subjects" aria-label="Book subjects"><p class="eyebrow">Browse by subject</p>{bookSections.map(section=><a href={`#${section.id}`}><span>{labels[section.id]}</span><span class="books-count">{section.books.length}</span></a>)}</nav>
   <div class="books-shelves">{bookSections.map((section,index)=><section class="books-shelf" id={section.id} aria-labelledby={`${section.id}-title`} tabindex="-1"><header><span class="books-section-number" aria-hidden="true">{String(index+1).padStart(2,'0')}</span><div><h2 id={`${section.id}-title`}>{labels[section.id]}</h2><p>{intros[section.id]}</p></div></header><div class="books-grid">{section.books.map(book=><article class="edition-book"><div class="edition-book-cover"><img src={book.cover} alt={`${book.title} cover`} width="160" height="230" loading="lazy" decoding="async"/></div><div class="edition-book-copy"><h3>{book.title.split(':')[0]}</h3><details><summary>About the book</summary><div>{book.title.includes(':')&&<p class="edition-book-subtitle">{book.title.slice(book.title.indexOf(':')+1).trim()}</p>}{book.paragraphs.map(paragraph=><p>{paragraph}</p>)}</div></details><a class="edition-book-buy" href={book.url} rel="sponsored noopener" aria-label={`Buy ${book.title} on Amazon`}>Buy on Amazon <span aria-hidden="true">→</span></a></div></article>)}</div><a class="books-top" href="#main">Back to top ↑</a></section>)}</div>
  </div>
 </main>
</Layout>
<style is:inline>
.books-edition{padding-bottom:30px}.books-cover{display:grid;grid-template-columns:1.3fr 1fr;gap:35px;align-items:center;background:var(--green);color:var(--paper);padding:38px;margin-top:26px;overflow:hidden}.books-cover h1{font:400 clamp(38px,5.6vw,80px)/1.12 var(--display);letter-spacing:-.025em;text-transform:uppercase}.books-cover h1 span{color:var(--yellow)}.books-cover>div>p:last-child{font-size:21px;line-height:1.6;max-width:530px;margin-top:22px}.books-cover-art{display:flex;align-items:end;justify-content:center;min-width:0;padding:28px 12px 16px;border-bottom:8px solid var(--yellow)}.books-cover-art img{width:34%;height:220px;object-fit:contain;filter:drop-shadow(5px 5px 0 #172017);transform:rotate(-9deg);margin-right:-8px}.books-cover-art img:nth-child(2){transform:rotate(4deg);height:245px;z-index:1}.books-cover-art img:nth-child(3){transform:rotate(11deg)}.books-disclosure{display:flex;justify-content:space-between;align-items:center;gap:28px;border-bottom:2px solid var(--ink);padding:20px 0}.books-disclosure p{font-size:14px;line-height:1.6;max-width:700px}.books-disclosure>span{font:700 12px/1.5 var(--ui);white-space:nowrap}.books-body{display:grid;grid-template-columns:200px minmax(0,1fr);gap:36px;margin-top:32px}.books-subjects{position:sticky;top:24px;align-self:start}.books-subjects>a{display:flex;align-items:baseline;justify-content:space-between;gap:16px;font:700 14px/1.5 var(--ui);padding:14px 0;border-top:1px solid var(--rule);text-decoration:none}.books-subjects>a:hover{text-decoration:underline}.books-count{font-size:12px;color:var(--green)}.books-shelf{scroll-margin-top:24px;border-bottom:2px solid var(--ink);padding-bottom:25px;margin-bottom:38px}.books-shelf>header{display:flex;gap:20px;align-items:start;margin-bottom:28px}.books-section-number{font:400 32px/1.2 var(--display);color:var(--green);padding-top:3px}.books-shelf h2{font:400 clamp(25px,2.8vw,38px)/1.3 var(--display);text-transform:uppercase;letter-spacing:-.02em;text-wrap:balance}.books-shelf>header p{font-size:17px;line-height:1.6;margin-top:10px}.books-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:30px 24px;align-items:start}.edition-book{min-width:0}.edition-book-cover{height:235px;display:flex;align-items:end;justify-content:center;padding:18px 20px;background:#e4ddc9;border-bottom:5px solid var(--green)}.edition-book:nth-child(3n+2) .edition-book-cover{background:var(--yellow)}.edition-book:nth-child(3n) .edition-book-cover{background:#ccd4b9}.edition-book-cover img{height:195px;width:auto;max-width:100%;object-fit:contain;filter:drop-shadow(4px 3px 0 #17201733)}.edition-book-copy{padding-top:16px}.edition-book h3{font:700 19px/1.45 var(--ui);text-wrap:pretty}.edition-book details{margin-top:8px}.edition-book summary{font:700 13px/1.6 var(--ui);padding:10px 0;min-height:44px;text-decoration:underline;text-underline-offset:3px}.edition-book details p{font-size:16px;line-height:1.65;margin:12px 0}.edition-book details .edition-book-subtitle{font-style:italic}.edition-book-buy{display:inline-block;font:700 13px/1.6 var(--ui);padding:12px 0;min-height:44px;color:var(--green)}.books-top{display:inline-block;font:700 12px/1.6 var(--ui);padding:14px 0;margin-top:14px}.books-shelf:focus{outline:0}.books-shelf:focus-visible{outline:3px solid var(--green);outline-offset:8px}
@media(max-width:1100px){.books-body{grid-template-columns:170px minmax(0,1fr);gap:24px}.books-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.books-cover-art img{height:170px}.books-cover-art img:nth-child(2){height:190px}}
@media(max-width:760px){.books-cover{grid-template-columns:minmax(0,1fr);padding:24px;gap:10px;margin-top:20px}.books-cover h1{font-size:clamp(32px,8.7vw,60px);line-height:1.2}.books-cover>div>p:last-child{font-size:18px;margin-top:18px}.books-cover-art{max-width:360px;width:100%;justify-self:center;padding:20px 8px 12px}.books-cover-art img{height:150px}.books-cover-art img:nth-child(2){height:170px}.books-disclosure{flex-direction:column;align-items:start;gap:12px}.books-body{grid-template-columns:minmax(0,1fr);gap:28px;margin-top:24px}.books-subjects{position:static}.books-subjects>a{padding:12px 0}.books-grid{gap:28px 18px}.books-shelf>header{gap:14px}.books-shelf h2{font-size:clamp(24px,6vw,34px)}.edition-book h3{font-size:18px}.edition-book-cover{height:205px;padding:16px}.edition-book-cover img{height:170px}.books-section-number{font-size:26px}}
@media(max-width:480px){.books-grid{grid-template-columns:minmax(0,1fr)}.edition-book-cover{height:235px}.edition-book-cover img{height:200px}.edition-book h3{font-size:22px}.edition-book details p{font-size:17px}.books-cover-art img{height:125px}.books-cover-art img:nth-child(2){height:145px}}
</style>
