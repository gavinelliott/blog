---
import deployment from '../../../vercel.json';
interface Props { title: string; description: string; image?: string; article?: boolean; publishDate?: Date; updatedDate?: Date; noindex?: boolean }
const {title,description,image='/images/writing-blog-post-placeholder.jpg',article=false,publishDate,updatedDate,noindex=false}=Astro.props;
const site=Astro.site!;
const url=new URL(Astro.url.pathname === '/404/' ? '/404.html' : Astro.url.pathname,site).href;
const imageURL=new URL(image,site).href;
const person={'@type':'Person','@id':new URL('/about/#gav',site).href,name:'Gavin Elliott',alternateName:'Gav Elliott',url:new URL('/about/',site).href,jobTitle:'Lead Product Designer',worksFor:{'@type':'Organization',name:'Deel',url:'https://www.deel.com/'},sameAs:['https://www.linkedin.com/in/gavin-elliott-1326a741/']};
const graph:any[]=[person,{'@type':'WebSite','@id':new URL('/#website',site).href,url:site.href,name:'Gav Elliott',publisher:{'@id':person['@id']}}];
if(article) graph.push({'@type':'BlogPosting',headline:title.replace(/ \| Gav Elliott$/,''),description,url,mainEntityOfPage:url,author:{'@id':person['@id']},datePublished:publishDate?.toISOString(),dateModified:(updatedDate || publishDate)?.toISOString(),image:imageURL});
if(Astro.url.pathname.replace(/\/$/,'')==='/about') graph.push({'@type':'ProfilePage',url,mainEntity:{'@id':person['@id']}});
if(article) graph.push({'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Writing',item:new URL('/writing/',site).href},{'@type':'ListItem',position:2,name:title.replace(/ \| Gav Elliott$/,''),item:url}]});
const policy=deployment.headers[0].headers.find(h=>h.key==='Content-Security-Policy')!.value.split(';').map(s=>s.trim()).filter(s=>!s.startsWith('frame-ancestors ')).join('; ');
---
<meta http-equiv="Content-Security-Policy" content={policy}/>
<title>{title}</title>
<meta name="description" content={description}/>
{noindex && <meta name="robots" content="noindex, follow"/>}
<link rel="canonical" href={url}/>
<link rel="alternate" type="application/rss+xml" title="Gavin Elliott" href="/rss.xml"/>
<meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={url}/><meta property="og:type" content={article?'article':'website'}/><meta property="og:image" content={imageURL}/><meta property="og:site_name" content="Gavin Elliott"/><meta property="og:locale" content="en_GB"/>
<meta name="twitter:card" content="summary_large_image"/><meta name="twitter:site" content="@gavinelliott"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={imageURL}/>
{publishDate && <meta property="article:published_time" content={publishDate.toISOString()}/>}
{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()}/>}
<script is:inline type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@graph':graph}).replace(/</g,'\\u003c')}/>
{import.meta.env.PROD && <script is:inline defer data-website-id="dfid_ikTQYTsEWtXNoGNvBIpxY" data-domain="gavinelliott.co.uk" src="https://datafa.st/js/script.cookieless.js"/>}
<script>
 if(import.meta.env.PROD && 'serviceWorker' in navigator) addEventListener('load',()=>{navigator.serviceWorker.register('/sw.js',{updateViaCache:'none'}).catch(()=>{});});
</script>
