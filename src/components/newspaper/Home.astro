---
import { apps } from './apps';
import { getCollection } from 'astro:content';
import Graphic from './Graphic.astro';



import Layout from './Layout.astro';
import './newspaper.css';

const posts = (await getCollection('blog')).sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const lead = posts.find(p => p.id === 'you-cannot-ai-your-way-out-of-the-wrong-problem')!;
const sideIds = ['why-i-still-care-about-this-more-than-i-probably-should', 'getting-into-agentic-coding'];
const sides = sideIds.map(id=>posts.find(p=>p.id === id)).filter(Boolean);
---
<Layout>
      <main id="main" tabindex="-1">
        <section class="introduction" aria-labelledby="intro-title">
          <div class="bridge"><Graphic kind="bridge" /></div>
          <h1 id="intro-title">Alright, I’m <span>Gav.</span></h1>
          <p>By day, Lead Product Designer at <a href="https://www.deel.com/">Deel</a>. By night, making apps of my own. I write about all of it here.</p>
        </section>

        <section class="front-stories" aria-label="Featured writing">
          <article class="lead-story">
            <p class="eyebrow green">From the writing</p>
            <h2><a href={`/blog/${lead.id}/`}>{lead.data.title}</a></h2>
            <div class="lead-bottom"><div><p>{lead.data.description}</p><a class="text-link" href={`/blog/${lead.id}/`}>Read the story <span aria-hidden="true">→</span></a></div><span class="burst" aria-label="Still making things"><span>Still<br/>making<br/>things</span></span></div>
          </article>
          <aside class="side-stories" aria-labelledby="elsewhere-heading">
            <h2 class="ribbon" id="elsewhere-heading">Elsewhere in my head<span aria-hidden="true">///</span></h2>
            {sides.map((post,index)=>post && <article><span class="story-number">0{index+1}/</span><div><h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3><p>{post.data.description}</p><a class="text-link" href={`/blog/${post.id}/`}>Read the story <span aria-hidden="true">→</span></a></div></article>)}
            <a class="text-link all-writing" href="/writing/">All the writing <span aria-hidden="true">→</span></a>
          </aside>
        </section>

        <section id="making" class="making" aria-label="Things I’m making">
          <a class="roundtails advert" href={apps.roundtails.href}>
            <div class="ad-copy"><p class="eyebrow"><span>On the workbench</span></p><h2>Roundtails</h2><p class="ad-description">Less admin.<br/> More time for the dogs.</p><span class="text-link">Explore Roundtails <span aria-hidden="true">→</span></span></div>
            <div class="dog-scene" aria-hidden="true"><svg class="walking-trail" viewBox="0 0 450 300" fill="none"><path d="M20 270C180 295 10 115 125 115S236 201 271 103S390 74 408 26" stroke="currentColor" stroke-width="5" stroke-dasharray="15 15" stroke-linecap="round"/><path d="M407 10C370 10 375 50 407 72C439 50 444 10 407 10Z" fill="var(--yellow)"/><circle cx="407" cy="31" r="9" fill="var(--green)"/></svg><img class="dog-art" src={apps.roundtails.art} alt="" width="600" height="420" loading="lazy" /></div>
          </a>
          <div class="classifieds">
            <a class="mini-ad nyah" href={apps.nyah.href}><div><h3>{apps.nyah.name}</h3><p>Your wardrobe,<br/>put to work.</p><span class="text-link">Meet Nyah <span aria-hidden="true">→</span></span></div><img class="brand-icon" src={apps.nyah.art} alt="" width="420" height="420" loading="lazy" decoding="async" /></a>
            <a class="mini-ad seek" href={apps.seek.href}><div><h3>{apps.seek.name}</h3><p>A little game of<br/>finding things.</p><span class="text-link">Take a look <span aria-hidden="true">→</span></span></div><img class="brand-icon" src={apps.seek.art} alt="" width="420" height="420" loading="lazy" decoding="async" /></a>
            <div class="project-index"><h3><span aria-hidden="true">▧</span> Computing<br/>& creative projects</h3><a href={apps.cv.href}>CV Anywhere <span aria-hidden="true">→</span></a><a href="https://craftedbyfort.com">All my apps <span aria-hidden="true">→</span></a><a href="/writing/ai-and-product-design/">Notes on building <span aria-hidden="true">→</span></a><p>Made at <a href="https://craftedbyfort.com">Crafted by Fort</a>.<br/>Written about here.</p></div>
          </div>
        </section>

        <section class="culture" aria-label="Books and talks">
          <a href="/recommended-reads/" class="books-feature"><div><h2>Good books.<br/>Dog-eared.</h2><p>Books that have stuck with me. On design, people and doing good work.</p><span class="text-link">Book recommendations <span aria-hidden="true">→</span></span></div><div class="book-stack" aria-hidden="true"><img src="/the-making-of-a-manager.jpg" alt="" width="120" height="180" loading="lazy"/><img src="/the-laws-of-simplicity-book.jpg" alt="" width="120" height="180" loading="lazy"/></div></a>
          <a href="/speaking/" class="talks-feature"><div><h2>On the<br/>record.</h2><p>Talks, conversations and a few things I’ve learned along the way.</p><span class="text-link">Explore the talks <span aria-hidden="true">→</span></span></div><Graphic kind="cassette" /></a>
        </section>

        <section class="archive" aria-label="Explore the archive"><div class="archive-symbol"><Graphic kind="sun" /></div><h2>The archive</h2><p>A deeper dive into the back catalogue. Older writing, ideas and things worth another look.</p><a href="/writing/" id="surprise" class="surprise" data-posts={JSON.stringify(posts.map(p=>`/blog/${p.id}/`))}>Surprise me <span aria-hidden="true">→</span></a></section>
      </main>
</Layout>
<style>
  .mini-ad .brand-icon {
    display: block;
    width: 100px;
    height: 100px;
    max-width: 32%;
    min-width: 0;
    flex: 0 1 100px;
    object-fit: contain;
    transform: rotate(-6deg);
  }
  @media (max-width: 1100px) {
    .mini-ad .brand-icon { width: 76px; height: 76px; flex-basis: 76px; }
  }
  @media (max-width: 760px) {
    .nameplate { gap: 8px; }
    .nameplate > a { font-size: 8.8vw; min-width: 0; }
    .monogram { width: 52px; height: 52px; }
    .mini-ad .brand-icon { width: 88px; height: 88px; max-width: 30%; flex-basis: 88px; }
    .seek .brand-icon { background: var(--paper); border-radius: 18%; transform: rotate(5deg); }
  }
</style>

<script>
const surprise=document.querySelector<HTMLAnchorElement>('#surprise');
surprise?.addEventListener('click',()=>{const urls:string[]=JSON.parse(surprise.dataset.posts || '[]');if(urls.length) surprise.href=urls[Math.floor(Math.random()*urls.length)];});
</script>
