---
import { getCollection } from 'astro:content';
import { topics } from '../../data/topics';
import Layout from './Layout.astro';
interface Props { topicSlug?: string }
const { topicSlug } = Astro.props;
const topic = topics.find(t => t.slug === topicSlug);
const all = (await getCollection('blog')).sort((a,b) => b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const posts = topic ? all.filter(p => topic.articles.includes(p.id)) : all;
const [lead, ...rest] = posts;
const titles: Record<string,string> = {'ai-and-product-design':'AI & product design','design-leadership':'Design leadership','design-careers':'Design careers'};
const title = topic ? titles[topic.slug] : 'All the writing';
const starter = topic ? all.find(p => p.id === topic.articles[0]) : all.find(p => p.id === 'getting-into-agentic-coding');
const date = (d:Date) => d.toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric',timeZone:'UTC'});
const minutes = (body:string|undefined) => Math.max(1,Math.ceil((body ?? '').split(/\s+/).length/220));
---
<Layout title={`${title} | Gav Elliott`} description={topic?.description || "Writing by Gavin Elliott on design, leadership and building products."}>
 <main id="main" tabindex="-1" class="writing-edition">
  <nav class="section-nav" aria-label="Writing topics">
   <a href="/writing/" aria-current={!topic ? 'page' : undefined}>All writing</a>
   {topics.map(t => <a href={`/writing/${t.slug}/`} aria-current={topic?.slug === t.slug ? 'page' : undefined}>{titles[t.slug]}</a>)}
  </nav>
  <header class="section-banner">
   <div class="section-kicker"><span>Writing</span><span>{String(posts.length).padStart(2,'0')} articles</span></div>
   <h1>{title}<span aria-hidden="true">.</span></h1>
   <p>{topic ? topic.description : 'I write about design, the things I’m building and what’s going on in my life.'}</p>
   <span class="print-mark" aria-hidden="true">✳</span>
  </header>
  {lead && <article class="section-lead">
   <div class="lead-label"><span class="eyebrow green">The latest</span><span class="issue-arrow" aria-hidden="true">↳</span></div>
   <div><p class="article-meta"><time datetime={lead.data.pubDate.toISOString()}>{date(lead.data.pubDate)}</time><span>{minutes(lead.body)} min read</span></p><h2><a href={`/blog/${lead.id}/`}>{lead.data.title}</a></h2><p class="lead-summary">{lead.data.description}</p><a class="text-link" href={`/blog/${lead.id}/`}>Read the story <span aria-hidden="true">→</span></a></div>
  </article>}
  <div class="writing-columns">
   <section aria-labelledby="more-heading" class="story-list"><h2 class="list-heading" id="more-heading">More articles <span aria-hidden="true">↓</span></h2>
    {rest.map((post,index) => <article class="archive-entry"><span class="entry-number" aria-hidden="true">{String(index+2).padStart(2,'0')}</span><div><p class="article-meta"><time datetime={post.data.pubDate.toISOString()}>{date(post.data.pubDate)}</time><span>{minutes(post.body)} min read</span></p><h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3><p>{post.data.description}</p></div><span class="entry-arrow" aria-hidden="true">→</span></article>)}
   </section>
   <aside class="desk-sidebar" aria-label="More to read and explore">
    {starter && <section class="start-note"><p class="eyebrow">Recommended reading</p><h2>Start here.</h2><div class="note-rule" aria-hidden="true">✳ ✳ ✳</div><a href={`/blog/${starter.id}/`} class="text-link">{starter.data.title} <span aria-hidden="true">→</span></a></section>}
    <section class="desk-note"><p class="eyebrow green">My apps</p><h2>What I’m<br/>building.</h2><p>I make apps through Crafted by Fort. Here’s what I’m working on.</p><a class="text-link" href="/work/">See what I’m building <span aria-hidden="true">→</span></a></section>
   </aside>
  </div>
  <div class="end-rule"><span>{posts.length} articles</span><a class="text-link" href={topic ? '/writing/' : '#main'}>{topic ? 'All the writing' : 'Back to the top'} <span aria-hidden="true">↑</span></a></div>
 </main>
</Layout>
<style>
.writing-columns > *{min-width:0}.archive-entry > div{min-width:0;overflow-wrap:normal;word-break:normal;hyphens:none}.desk-sidebar{min-width:0;overflow-wrap:normal;word-break:normal;hyphens:none}
.section-nav{display:flex;gap:8px 24px;flex-wrap:wrap;padding:18px 0}.section-nav a{font:700 13px/1.3 var(--ui);padding:10px 0;text-decoration:none}.section-nav a[aria-current]{text-decoration:underline;text-decoration-thickness:3px;text-underline-offset:7px;color:var(--green)}.section-nav a:hover{text-decoration:underline}
.section-banner{background:var(--green);color:var(--paper);padding:24px 30px 30px;position:relative;overflow:hidden}.section-kicker{display:flex;justify-content:space-between;gap:20px;font:700 12px/1.4 var(--ui);text-transform:uppercase;border-bottom:1px solid #f4ecd870;padding-bottom:14px;margin-bottom:22px}.section-banner h1{font:400 clamp(42px,6.8vw,96px)/1 var(--display);letter-spacing:-.035em;text-transform:uppercase;max-width:1000px;position:relative;z-index:1}.section-banner h1 span{color:var(--yellow)}.section-banner>p{max-width:760px;font-size:20px;margin-top:18px;padding-right:55px}.print-mark{position:absolute;right:22px;bottom:-30px;color:var(--yellow);font:180px/1 Georgia;transform:rotate(12deg)}
.section-lead{display:grid;grid-template-columns:145px 1fr;gap:24px;padding:36px 0;border-bottom:3px solid var(--ink)}.lead-label{display:flex;flex-direction:column;gap:24px}.issue-arrow{font:100px/1 var(--display);color:var(--green)}.article-meta{display:flex;gap:16px;flex-wrap:wrap;font:700 11px/1.4 var(--ui);text-transform:uppercase;margin-bottom:12px}.article-meta span{border-left:1px solid var(--rule);padding-left:16px}.section-lead h2{font:400 clamp(36px,4.6vw,65px)/1.05 var(--display);text-transform:uppercase;letter-spacing:-.025em;max-width:1000px}.section-lead h2 a,.archive-entry h3 a{text-decoration:none}.section-lead h2 a:hover,.archive-entry h3 a:hover{text-decoration:underline;text-decoration-thickness:2px}.lead-summary{max-width:760px;margin:18px 0 12px;font-size:20px}
.writing-columns{display:grid;grid-template-columns:minmax(0,2.2fr) minmax(0,1fr);gap:36px;padding:28px 0 35px}.list-heading{font:700 15px var(--ui);text-transform:uppercase;border-bottom:1px solid var(--ink);padding-bottom:16px;display:flex;justify-content:space-between}.archive-entry{display:grid;grid-template-columns:48px minmax(0,1fr) 25px;gap:18px;padding:28px 0;border-bottom:1px solid var(--rule)}.entry-number{font:400 34px/1 var(--display);color:var(--green)}.archive-entry h3{font:400 clamp(25px,2.4vw,34px)/1.15 var(--serif);letter-spacing:-.035em}.archive-entry div>p:last-child{margin-top:12px;font-size:16px}.entry-arrow{font-size:25px;color:var(--green)}.desk-sidebar{border-left:1px solid var(--rule);padding-left:30px}.start-note{background:var(--yellow);padding:24px}.start-note{container-type:inline-size}.start-note h2{font:400 clamp(24px,18cqi,46px)/1 var(--display);text-transform:uppercase;letter-spacing:-.02em}.note-rule{font-size:25px;border-bottom:2px solid;margin:16px 0;padding-bottom:12px;letter-spacing:8px}.start-note p:not(.eyebrow){font-size:16px;margin-bottom:18px}.start-note .text-link{color:var(--ink)}.desk-note{padding:26px 0;border-bottom:1px solid var(--rule)}.desk-note h2{font:400 30px/1.1 var(--serif);letter-spacing:-.03em}.desk-note p:not(.eyebrow){font-size:16px;margin:12px 0}.margin-note{font-size:15px;font-style:italic;line-height:1.6;margin:20px 0}.end-rule{border-top:3px solid; border-bottom:1px solid;display:flex;justify-content:space-between;gap:20px;padding:20px 0;font:italic 15px var(--serif)}
@media(max-width:760px){.section-nav{gap:4px 18px;padding:12px 0}.section-nav a{font-size:12px;min-height:44px;display:flex;align-items:center}.section-banner{padding:20px}.section-kicker{font-size:10px;gap:15px}.section-kicker span:last-child{text-align:right}.section-banner h1{font-size:clamp(37px,10vw,70px)}.section-banner>p{font-size:17px;padding-right:0;position:relative;z-index:1}.print-mark{display:none}.section-lead{grid-template-columns:1fr;gap:12px;padding:24px 0}.lead-label{display:block}.issue-arrow{display:none}.section-lead h2{font-size:clamp(34px,8.8vw,55px)}.lead-summary{font-size:18px}.writing-columns{grid-template-columns:minmax(0,1fr);gap:24px;padding-top:22px}.archive-entry{grid-template-columns:32px minmax(0,1fr);gap:12px;padding:24px 0}.entry-number{font-size:27px}.entry-arrow{display:none}.archive-entry h3{font-size:26px}.article-meta{font-size:10px;gap:10px}.article-meta span{padding-left:10px}.desk-sidebar{border-left:0;padding-left:0}.start-note h2{font-size:clamp(24px,18cqi,44px)}.start-note h2 br{display:none}.end-rule{flex-direction:column;gap:8px}}
</style>
