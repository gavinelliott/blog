---
import Layout from './Layout.astro';
import artwork from './assets/404-thundercats.webp?url';
---
<Layout title="404 · Sight beyond site | Gav Elliott">
 <main id="main" tabindex="-1" class="lost-edition">
  <div class="lost-broadcast" aria-hidden="true"><span>Saturday morning. Somewhere in the 80s.</span><span>No signal / 404</span></div>
  <section class="lost-scene" aria-labelledby="lost-title">
   <img class="lost-art" src={artwork} alt="Lion-O raises the Sword of Omens beneath a glowing ThunderCats emblem, with lightning over an alien landscape" width="1536" height="1024" fetchpriority="high"/>
   <div class="lost-title"><p class="lost-code" aria-label="Error 404">404</p><h1 id="lost-title">Sight <br/>beyond <br/><span>site.</span></h1><p class="lost-missing">Page not found.</p></div>
   <span class="lost-caption" aria-hidden="true">Even the sword couldn’t find this one.</span>
  </section>
  <section class="lost-rescue" aria-labelledby="lost-help"><div><h2 id="lost-help">Well, this isn’t where<br/>you were meant to end up.</h2><p>The page might have moved, or the link might be wrong.</p></div><nav aria-label="Find your way back"><a class="lost-home" href="/design/home/">Back home <span aria-hidden="true">→</span></a><a href="/design/writing/">Read the writing <span aria-hidden="true">→</span></a><button type="button" data-open-search>Search the archive <span aria-hidden="true">⌕</span></button></nav></section>
 </main>
</Layout>
<style is:inline>
.lost-edition{padding:24px 0 35px}.lost-broadcast{display:flex;justify-content:space-between;gap:16px;border:2px solid var(--ink);border-bottom:0;background:var(--yellow);padding:12px 18px;font:700 11px/1.5 var(--ui);text-transform:uppercase;letter-spacing:.06em}.lost-scene{width:100%;position:relative;isolation:isolate;min-height:660px;aspect-ratio:3/2;background:#07462e;color:var(--paper);border:2px solid var(--ink);overflow:hidden}.lost-art{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:right center;z-index:-2;animation:lost-arrival 650ms ease-out both}.lost-title{position:relative;padding:32px 40px;width:52%;text-shadow:3px 3px 0 #073b27}.lost-code{font:400 clamp(65px,9vw,125px)/1 var(--display);letter-spacing:-.04em;color:var(--yellow);margin-bottom:15px}.lost-title h1{font:400 clamp(42px,6.7vw,94px)/1.02 var(--display);text-transform:uppercase;letter-spacing:-.025em;word-break:normal;overflow-wrap:normal}.lost-title h1 span{color:var(--yellow)}.lost-missing{font:700 14px/1.5 var(--ui);margin-top:22px;display:inline-block;background:#123f2b;padding:8px 12px;border:1px solid var(--paper)}.lost-caption{position:absolute;bottom:18px;left:20px;background:var(--ink);color:var(--paper);padding:8px 12px;font:700 11px/1.5 var(--ui)}.lost-rescue{display:grid;grid-template-columns:1.3fr 1fr;gap:40px;align-items:center;border-bottom:3px solid var(--ink);padding:30px 0}.lost-rescue h2{font:400 clamp(25px,2.8vw,38px)/1.2 var(--display);text-transform:uppercase;letter-spacing:-.015em}.lost-rescue p{font-size:18px;line-height:1.6;margin-top:14px}.lost-rescue nav{display:grid;gap:10px}.lost-rescue a,.lost-rescue button{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:14px 18px;min-height:48px;border:2px solid var(--ink);background:var(--paper);color:var(--ink);text-decoration:none;font:700 14px/1.5 var(--ui);transition:box-shadow 160ms ease,transform 160ms ease}.lost-rescue .lost-home{background:var(--green);color:var(--paper)}.lost-rescue a:hover,.lost-rescue button:hover{box-shadow:4px 4px 0 var(--yellow);transform:translate(-2px,-2px);text-decoration:underline}.lost-rescue a:active,.lost-rescue button:active{transform:none;box-shadow:none}@keyframes lost-arrival{from{opacity:.4;transform:scale(1.025)}to{opacity:1;transform:scale(1)}}
@media(max-width:1000px){.lost-scene{min-height:550px}.lost-title{padding:30px;width:55%}.lost-title h1{font-size:clamp(44px,6.7vw,70px)}}
@media(max-width:650px){.lost-edition{padding-top:18px}.lost-broadcast{padding:10px;font-size:9px;gap:10px}.lost-broadcast>span:first-child{max-width:160px}.lost-broadcast>span:last-child{text-align:right}.lost-scene{min-height:0;aspect-ratio:auto;padding-top:0;overflow:hidden}.lost-art{position:relative;display:block;inset:auto;width:100%;height:auto;aspect-ratio:3/2;object-fit:contain;animation:none}.lost-title{width:100%;padding:22px;background:#07462e;text-shadow:none;border-bottom:1px solid #759b75}.lost-scene{display:flex;flex-direction:column}.lost-title{order:-1}.lost-code{font-size:65px;margin-bottom:12px}.lost-title h1{font-size:clamp(32px,8.8vw,55px);line-height:1.08}.lost-title h1 br{display:none}.lost-title h1 br:after{content:' '}.lost-title h1 span{display:block}.lost-missing{margin-top:18px;font-size:12px}.lost-caption{position:static;font-size:10px;padding:12px;text-align:center}.lost-rescue{grid-template-columns:minmax(0,1fr);gap:24px;padding:25px 0}.lost-rescue h2{font-size:26px}.lost-rescue p{font-size:17px}}
@media(prefers-reduced-motion:reduce){.lost-art{animation:none}.lost-rescue a,.lost-rescue button{transition:none}.lost-rescue a:hover,.lost-rescue button:hover{transform:none}}
</style>
