---
import Layout from './Layout.astro';
import Graphic from './Graphic.astro';
import history from './speaking-history.json';
---
<Layout title="Speaking & talks | Gav Elliott">
 <main id="main" tabindex="-1" class="speaking-edition">
  <header class="speaking-intro"><div><p class="eyebrow">Speaking & talks</p><h1>On stage.<br/>In conversation<span>.</span></h1><p>Talks, conversations and the conferences I’ve been part of.</p></div><div class="speaking-cassette"><Graphic kind="cassette"/></div></header>
  <section class="speaking-feature" aria-labelledby="featured-talk"><img src="/impostor-syndrome-talk.jpg" alt="Me speaking to an audience about mental health" width="1024" height="768"/><div><p class="eyebrow">From the talk archive</p><h2 id="featured-talk">Impostor<br/>Syndrome</h2><p>A talk I gave about mental health and the things we don’t always say out loud.</p><a class="speaking-link" href="/design/talks/imposter-syndrome/">About the talk <span aria-hidden="true">→</span></a></div></section>
  <aside class="speaking-update"><p>My thinking on impostor syndrome has changed.</p><a href="/design/post/i-dont-think-about-impostor-syndrome-in-the-same-way-anymore/">Read where I am with it now →</a></aside>
  <section class="speaking-recordings" aria-labelledby="recordings-title"><h2 id="recordings-title">Watch, listen & read</h2><div><article><p class="eyebrow">Podcast · 2025</p><h3>From burnout<br/>to building</h3><p>A conversation with Danny Hearn about design, AI, burnout and leading authentically.</p><a class="speaking-link" href="https://www.youtube.com/watch?v=cZ-4bxvMcnE">Watch on YouTube →</a><a href="/design/post/from-burnout-to-building-a-conversation-on-design-ai-and-leading-authentically/">Read my reflections →</a></article><article><p class="eyebrow">Audio · MK Geek Night · 2014</p><h3>Invisible<br/>Challenges</h3><p>The audio recording from my talk at MK Geek Night.</p><a class="speaking-link" href="https://soundcloud.com/mkgn/mental-help-gavin-elliott">Listen on SoundCloud →</a></article><article><p class="eyebrow">Talk notes · Camp Digital · 2018</p><h3>Professional<br/>Progression</h3><p>My notes on the talk I gave at Camp Digital about progressing in your career.</p><a class="speaking-link" href="/design/post/professional-progression/">Read the notes →</a></article></div></section>
  <section class="speaking-history" aria-labelledby="history-title"><header><p class="eyebrow">Conferences, teams & meetups</p><h2 id="history-title">Where I’ve spoken</h2><p>Talks, hosting and events I’ve organised.</p></header><div class="speaking-history-body"><nav aria-label="Speaking years">{history.map(group=><a href={`#year-${group.year}`}>{group.year}</a>)}</nav><div>{history.map(group=><section id={`year-${group.year}`} aria-labelledby={`heading-${group.year}`} tabindex="-1"><h3 id={`heading-${group.year}`}>{group.year}</h3><ul>{group.entries.map(entry=><li set:html={entry}/>)}</ul></section>)}</div></div></section>
 </main>
</Layout>
<style is:inline>
.speaking-intro{display:grid;grid-template-columns:minmax(0,2.1fr) minmax(0,1fr);gap:32px;align-items:center;padding:36px 0;border-bottom:3px solid var(--ink)}.speaking-intro h1{font:400 clamp(36px,5.6vw,80px)/1.15 var(--display);letter-spacing:-.03em;text-transform:uppercase}.speaking-intro h1 span{color:var(--green)}.speaking-intro>div>p:last-child{font-size:21px;line-height:1.6;margin-top:22px}.speaking-cassette{background:var(--yellow);padding:25px;transform:rotate(3deg);margin:15px}.speaking-feature{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);background:var(--green);color:var(--paper);margin-top:28px}.speaking-feature>img{display:block;width:100%;height:100%;object-fit:cover}.speaking-feature>div{padding:36px}.speaking-feature h2{font:400 clamp(32px,4.8vw,64px)/1.2 var(--display);text-transform:uppercase;letter-spacing:-.02em}.speaking-feature p:not(.eyebrow){font-size:20px;line-height:1.6;margin:20px 0}.speaking-link{display:inline-block;font:700 15px/1.6 var(--ui);padding:12px 0;min-height:44px}.speaking-update{display:flex;align-items:baseline;justify-content:space-between;gap:25px;background:var(--yellow);padding:22px 28px}.speaking-update p{font-size:20px;line-height:1.5}.speaking-update a{font:700 14px/1.6 var(--ui)}.speaking-recordings{padding:38px 0}.speaking-recordings h2,.speaking-history h2{font:400 clamp(30px,3.5vw,44px)/1.25 var(--display);text-transform:uppercase;margin-bottom:24px}.speaking-recordings>div{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px}.speaking-recordings article{padding:22px 0;border-top:2px solid var(--ink)}.speaking-recordings h3{font:400 clamp(24px,2.7vw,36px)/1.3 var(--display);text-transform:uppercase;margin:12px 0}.speaking-recordings article>p:not(.eyebrow){font-size:18px;line-height:1.6;margin-bottom:14px}.speaking-recordings article>a{display:block}.speaking-recordings article>a:not(.speaking-link){font-size:15px;padding:8px 0}.speaking-history{border-top:3px solid var(--ink);padding:32px 0}.speaking-history header>p:last-child{font-size:20px;margin-bottom:30px}.speaking-history-body{display:grid;grid-template-columns:150px minmax(0,1fr);gap:40px}.speaking-history-body>nav{position:sticky;top:24px;align-self:start;display:flex;flex-direction:column}.speaking-history-body>nav>a{font:700 15px/1.5 var(--ui);padding:10px 0;border-top:1px solid var(--rule)}.speaking-history-body section{scroll-margin-top:24px;display:grid;grid-template-columns:130px minmax(0,1fr);gap:24px;border-top:1px solid var(--ink);padding:22px 0}.speaking-history-body h3{font:400 30px/1.3 var(--display);color:var(--green)}.speaking-history-body ul{padding:0;margin:0;list-style:none}.speaking-history-body li{font-size:18px;line-height:1.65;padding:0 0 18px}.speaking-history-body li+li{border-top:1px solid var(--rule);padding-top:18px}
@media(max-width:1000px){.speaking-feature>div{padding:26px}.speaking-recordings>div{gap:20px}.speaking-update{align-items:start;flex-direction:column;gap:10px}}
@media(max-width:760px){.speaking-intro{grid-template-columns:minmax(0,1fr);gap:18px;padding:26px 0}.speaking-intro h1{font-size:clamp(28px,7.8vw,54px)}.speaking-intro>div>p:last-child{font-size:18px}.speaking-cassette{width:190px;justify-self:end;margin:0 8px 10px;padding:15px}.speaking-feature{grid-template-columns:minmax(0,1fr)}.speaking-feature>img{height:auto}.speaking-feature>div{padding:24px}.speaking-feature h2{font-size:clamp(32px,9vw,50px)}.speaking-feature p:not(.eyebrow){font-size:18px}.speaking-update{padding:22px}.speaking-recordings>div{grid-template-columns:minmax(0,1fr);gap:0}.speaking-recordings h3{font-size:32px}.speaking-history-body{grid-template-columns:minmax(0,1fr);gap:24px}.speaking-history-body>nav{position:static;flex-direction:row;flex-wrap:wrap;gap:8px 20px}.speaking-history-body>nav>a{padding:10px 4px}.speaking-history-body section{grid-template-columns:minmax(0,1fr);gap:18px}.speaking-history-body li{font-size:17px}}
</style>
