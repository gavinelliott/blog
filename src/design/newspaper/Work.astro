---
import { getCollection } from 'astro:content';
import { moreApps } from './apps';
import Layout from './Layout.astro';
import tonenIcon from './assets/tonen-editorial.webp?url';
import cadenceIcon from './assets/cadence-editorial.webp?url';
import pigeonIcon from './assets/pigeon-editorial.webp?url';
import venueIcon from './assets/venue-editorial.webp?url';
import dog from './assets/dog.svg?url';
import nyah from './assets/nyah-mascot.webp?url';
import seek from './assets/seek-mascot.webp?url';
const work = (await getCollection('work')).filter(p=>!p.data.draft).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const posts = await getCollection('blog');
const notes = ['getting-into-agentic-coding','building-for-yourself-vs-building-for-users','why-senior-designers-should-build-products-not-just-decks'].map(id=>posts.find(p=>p.id===id)).filter(p=>p!==undefined);
---
<Layout title="Work & apps | Gav Elliott">
 <main id="main" tabindex="-1" class="work-edition">
  <header class="work-intro"><p class="eyebrow">Work & apps</p><h1>Things I’m<br/>working on<span>.</span></h1><p>I’m a Lead Product Designer at Deel. I also build apps of my own through <a href="https://craftedbyfort.com">Crafted by Fort</a>.</p></header>
  <section class="day-job" aria-labelledby="deel-title"><div><p class="eyebrow">By day</p><h2 id="deel-title">Deel</h2></div><div><h3>Lead Product Designer</h3><p>I lead design in Core, the group of teams building the foundations of Deel.</p><p>That covers AI, Design System, Platform, Settings, Motion and Animation, Mobile, Home and Analytics.</p><a class="text-link" href="https://www.deel.com/">About Deel <span aria-hidden="true">→</span></a></div><div class="job-note"><p>Writing about design</p><a href="/design/writing/design-leadership/">Leading teams →</a><a href="/design/writing/ai-and-product-design/">AI & product design →</a></div></section>
  <section class="app-section" aria-labelledby="apps-title"><header class="work-section-heading"><h2 id="apps-title">My apps</h2><a href="https://craftedbyfort.com">Crafted by Fort →</a></header>
   <article class="roundtails-project"><div><p class="eyebrow">For dog walkers</p><h3>Roundtails</h3><p>Bookings, client details and the walking week. I’m building Roundtails to help dog walkers manage their business.</p><a class="project-link" href="/design/work/roundtails/">About Roundtails <span aria-hidden="true">→</span></a></div><div class="project-dog" aria-hidden="true"><span class="dog-sun"></span><img src={dog} alt="" width="600" height="420" loading="lazy"/></div></article>
   <article class="roundtails-project spotlight tonen-spotlight" id="tonen"><div><p class="eyebrow">Finding the words</p><h3>tonen</h3><p>Find words for real moments.</p><a class="project-link" href="https://apps.apple.com/app/tonen/id6751059999">tonen on the App Store <span aria-hidden="true">→</span></a></div><div class="spotlight-art" aria-hidden="true"><img src={tonenIcon} alt="" width="180" height="180" loading="lazy" decoding="async"/></div></article>
   <article class="roundtails-project spotlight cadence-spotlight" id="cadence"><div><p class="eyebrow">Habit tracking</p><h3>Cadence</h3><p>Make room for better habits.</p><a class="project-link" href="https://apps.apple.com/us/app/cadence-habit-tracker/id6757691383">Cadence on the App Store <span aria-hidden="true">→</span></a></div><div class="spotlight-art" aria-hidden="true"><img src={cadenceIcon} alt="" width="180" height="180" loading="lazy" decoding="async"/></div></article>
   <div class="app-pair promoted-pair"><article class="pigeon-project" id="pigeon-toss"><div class="app-heading"><h3>Pigeon Toss</h3><img src={pigeonIcon} alt="" width="100" height="100" loading="lazy" decoding="async"/></div><p>A coin-toss game.</p><a class="project-link" href="https://apps.apple.com/gb/app/pigeon-toss-coin-toss-game/id6801862575">Pigeon Toss on the App Store <span aria-hidden="true">→</span></a></article><article class="venue-project"><div class="app-heading"><h3>ReadyVenue</h3><img src={venueIcon} alt="" width="100" height="100" loading="lazy" decoding="async"/></div><p>Venue preparation for Martyn’s Law.</p><a class="project-link" href="https://apps.apple.com/gb/app/readyvenue/id6812269465">ReadyVenue on the App Store <span aria-hidden="true">→</span></a></article></div>
   <div class="app-pair"><article class="nyah-project" id="nyah"><div class="app-heading"><h3>Nyah</h3><img src={nyah} alt="" width="100" height="100" loading="lazy" decoding="async"/></div><p>A wardrobe and outfit planner for your iPhone.</p><a class="project-link" href="https://apps.apple.com/app/nyah-outfit-planner/id6756782251">Nyah on the App Store <span aria-hidden="true">→</span></a></article><article class="seek-project" id="seek"><div class="app-heading"><h3>Seek</h3><img src={seek} alt="" width="100" height="100" loading="lazy" decoding="async"/></div><p>A photo scavenger hunt. Find things around you and take a picture.</p><a class="project-link" href="https://apps.apple.com/gb/app/seek-photo-scavenger-hunt/id6758464369">Seek on the App Store <span aria-hidden="true">→</span></a></article></div>
   <article class="cv-project"><span class="cv-stamp" aria-hidden="true">CV</span><div><h3>CV Anywhere</h3><p>Build your CV, tailor it to a role and keep track of your applications.</p></div><a class="project-link" href="https://cvanywhere.com">Visit CV Anywhere <span aria-hidden="true">→</span></a></article>
  </section>
  <section class="more-apps" aria-labelledby="more-apps-title"><header class="work-section-heading"><h2 id="more-apps-title">More apps</h2><span>Web & iOS</span></header><div class="app-catalogue">{moreApps.map((app,index)=><article><span class="catalogue-number" aria-hidden="true">{String(index+9).padStart(2,'0')}</span><div><h3><a href={app.href}>{app.name}</a></h3><p>{app.description}</p></div><span aria-hidden="true" class="catalogue-arrow">→</span></article>)}</div></section>
  <section class="older-projects" aria-labelledby="older-projects-title"><h2 id="older-projects-title">Earlier projects</h2><div><article><h3><a href="/design/post/building-cleanreader-one-click-to-better-reading/">CleanReader</a></h3><p>A Chrome extension for reading articles without the clutter.</p><a class="text-link" href="/design/post/building-cleanreader-one-click-to-better-reading/">How I built it →</a></article><article><h3><a href="/shipped/bestaithings/">Best AI Things</a></h3><p>A directory of AI tools.</p><a class="text-link" href="/shipped/bestaithings/">About the project →</a></article></div></section>
  <div class="work-bottom"><section aria-labelledby="building-title"><h2 id="building-title">Writing about building</h2>{notes.map(post=><article class="work-note"><h3><a href={`/design/post/${post.id}/`}>{post.data.title}</a></h3><p>{post.data.description}</p></article>)}</section><section class="earlier-work" aria-labelledby="earlier-title"><h2 id="earlier-title">Earlier work</h2><p class="earlier-intro">Some of the work I did before Deel.</p>{work.map(project=><article><p>{project.data.client}</p><h3><a href={`/work/${project.id}/`}>{project.data.title}</a></h3></article>)}</section></div>
 </main>
</Layout>
<style is:inline>
.more-apps{padding:6px 0 28px;border-bottom:2px solid var(--ink)}.more-apps header>span{font:700 12px var(--ui)}.app-catalogue{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);column-gap:36px}.app-catalogue article{display:grid;grid-template-columns:32px minmax(0,1fr) 20px;gap:16px;padding:24px 0;border-top:1px solid var(--rule)}.catalogue-number{font:400 24px/1.4 var(--display);color:var(--green)}.app-catalogue h3{font:700 23px/1.4 var(--ui);margin-bottom:8px}.app-catalogue h3 a{text-decoration:none}.app-catalogue h3 a:hover{text-decoration:underline}.app-catalogue p{font-size:17px;line-height:1.6}.catalogue-arrow{color:var(--green);padding-top:8px}.older-projects{padding:28px;background:var(--yellow);margin-top:24px}.older-projects h2{font:400 30px/1.4 var(--display);text-transform:uppercase;margin-bottom:20px}.older-projects>div{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:32px}.older-projects h3{font:700 22px/1.4 var(--ui);margin-bottom:10px}.older-projects p{margin-bottom:12px}.older-projects .text-link{color:var(--ink)}
@media(max-width:760px){.app-catalogue{grid-template-columns:minmax(0,1fr)}.app-catalogue article{gap:12px;grid-template-columns:28px minmax(0,1fr) 16px}.app-catalogue h3{font-size:21px}.older-projects{padding:22px}.older-projects>div{grid-template-columns:minmax(0,1fr);gap:24px}.older-projects h2{font-size:26px}}

.work-intro{padding:32px 0;border-bottom:3px solid var(--ink)}.work-intro .eyebrow{color:var(--green)}.work-intro h1{font:400 clamp(38px,6.4vw,90px)/1.12 var(--display);text-transform:uppercase;letter-spacing:-.03em;text-wrap:balance}.work-intro h1 span{color:var(--green)}.work-intro>p:last-child{font-size:22px;line-height:1.5;max-width:780px;margin-top:22px;text-wrap:pretty}
.day-job{display:grid;grid-template-columns:1fr 1.6fr 1fr;gap:32px;padding:28px 0;border-bottom:1px solid var(--ink)}.day-job h2{font:400 62px/1 var(--display);letter-spacing:-.025em}.day-job h3{font:700 20px/1.4 var(--ui);margin-bottom:10px}.day-job p{margin-bottom:12px}.job-note{border-left:1px solid var(--rule);padding-left:25px}.job-note p{font:700 13px/1.5 var(--ui)}.job-note a{display:block;font:400 16px/1.5 var(--serif);padding:8px 0;color:var(--green)}
.work-section-heading{display:flex;align-items:baseline;justify-content:space-between;gap:20px;padding:28px 0 18px}.work-section-heading h2,.work-bottom h2{font:400 36px/1.2 var(--display);text-transform:uppercase}.work-section-heading a{font:700 13px/1.5 var(--ui)}.roundtails-project{background:var(--green);color:var(--paper);display:grid;grid-template-columns:1.3fr 1fr;overflow:hidden;min-height:330px}.roundtails-project>div:first-child{padding:32px;position:relative;z-index:1}.roundtails-project h3{font:400 clamp(38px,6vw,84px)/1.1 var(--display);text-transform:uppercase;letter-spacing:-.03em}.roundtails-project p:not(.eyebrow){max-width:520px;font-size:20px;line-height:1.6;margin:18px 0}.project-link{display:inline-block;font:700 15px/1.5 var(--ui);padding:10px 0}.project-dog{position:relative;min-width:0;align-self:stretch;min-height:280px}.project-dog img{position:absolute;width:100%;height:100%;object-fit:contain;bottom:-9%;transform:rotate(-3deg)}.dog-sun{position:absolute;width:160px;height:160px;border-radius:50%;background:var(--yellow);top:35px;right:40px}
.app-pair{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin:22px 0}.app-pair article{padding:28px;display:flex;flex-direction:column;min-width:0}.nyah-project{background:var(--yellow)}.seek-project{border:2px solid var(--green)}.app-heading{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:12px}.app-heading h3{font:400 60px/1.1 var(--display);text-transform:uppercase}.app-heading img{width:92px;height:92px;object-fit:contain;transform:rotate(-5deg)}.app-pair p{font-size:20px;line-height:1.6;max-width:440px;margin-bottom:14px}.app-pair .project-link{margin-top:auto}.cv-project{display:flex;gap:28px;align-items:center;border-top:2px solid var(--ink);border-bottom:2px solid var(--ink);padding:25px 0}.cv-stamp{background:var(--green);color:var(--paper);font:400 40px/1 var(--display);padding:18px 12px;transform:rotate(-5deg);flex-shrink:0}.cv-project h3{font:700 26px/1.4 var(--ui);margin-bottom:6px}.cv-project>div{flex:1}.cv-project>.project-link{flex-shrink:0}
.work-bottom{display:grid;grid-template-columns:1.5fr 1fr;gap:45px;padding:35px 0}.work-bottom h2{font-size:30px;text-wrap:balance;margin-bottom:20px}.work-note{border-top:1px solid var(--rule);padding:20px 0}.work-note h3{font:400 27px/1.4 var(--serif);margin-bottom:12px}.work-note h3 a{text-decoration:none}.work-note h3 a:hover{text-decoration:underline}.work-note p{font-size:16px;line-height:1.6}.earlier-work{padding-left:30px;border-left:1px solid var(--rule)}.earlier-intro{margin-bottom:20px;font-style:italic}.earlier-work article{border-top:1px solid var(--rule);padding:16px 0}.earlier-work article p{font:700 12px/1.5 var(--ui);color:var(--green);margin-bottom:8px}.earlier-work h3{font:400 21px/1.4 var(--serif)}
@media(max-width:1000px){.day-job{grid-template-columns:1fr 2fr}.job-note{grid-column:1/-1;display:flex;gap:24px;align-items:baseline;border-left:0;border-top:1px solid var(--rule);padding:16px 0 0}.roundtails-project{grid-template-columns:1.4fr 1fr}.cv-project{flex-wrap:wrap}.cv-project>.project-link{margin-left:100px}.work-bottom{gap:25px}}
@media(max-width:760px){.work-intro{padding:24px 0}.work-intro h1{font-size:clamp(30px,8vw,52px);line-height:1.4}.work-intro>p:last-child{font-size:19px}.day-job{grid-template-columns:minmax(0,1fr);gap:20px;padding:24px 0}.day-job h2{font-size:52px}.job-note{flex-wrap:wrap;gap:0 20px}.job-note p{width:100%;margin-bottom:4px}.work-section-heading{align-items:start;flex-direction:column;gap:8px}.roundtails-project{grid-template-columns:minmax(0,1fr)}.roundtails-project>div:first-child{padding:24px}.roundtails-project h3{font-size:clamp(28px,8.2vw,52px)}.roundtails-project p:not(.eyebrow){font-size:18px}.project-dog{min-height:240px;margin-top:-10px}.project-dog img{bottom:-16%;height:120%}.dog-sun{width:140px;height:140px;top:10px}.app-pair{grid-template-columns:minmax(0,1fr);gap:16px;margin:16px 0}.app-pair article{padding:22px}.app-heading h3{font-size:48px}.app-heading img{width:76px;height:76px}.app-pair p{font-size:18px}.cv-project{gap:20px}.cv-stamp{font-size:28px;padding:14px 9px}.cv-project h3{font-size:22px}.cv-project>.project-link{margin-left:0}.work-bottom{grid-template-columns:minmax(0,1fr);padding-top:28px}.work-bottom h2{font-size:27px;line-height:1.4}.work-note h3{font-size:24px}.earlier-work{border-left:0;padding-left:0;border-top:2px solid var(--ink);padding-top:24px}}

.spotlight{margin-top:22px;min-height:330px}.tonen-spotlight{background:var(--yellow);color:var(--ink)}.cadence-spotlight{background:var(--green);color:var(--paper)}.spotlight-art{position:relative;display:flex;justify-content:center;align-items:center;min-width:0;min-height:300px;isolation:isolate}.spotlight-art>img{width:160px;height:160px;object-fit:contain;border-radius:24%;transform:rotate(-6deg);box-shadow:8px 8px 0 var(--ink);z-index:1}.quote-mark{position:absolute;font:400 440px/1 Georgia,serif;color:var(--green);left:0;top:-30px}.cadence-beats{position:absolute;inset:45px 25px;display:flex;align-items:end;justify-content:space-between;gap:16px;transform:rotate(-8deg)}.cadence-beats i{display:block;flex:1;background:var(--yellow);height:45%}.cadence-beats i:nth-child(2){height:65%}.cadence-beats i:nth-child(3){height:55%}.cadence-beats i:nth-child(4){height:85%}.cadence-beats i:nth-child(5){height:100%}.pigeon-project{background:var(--green);color:var(--paper)}.venue-project{background:var(--yellow);color:var(--ink)}.promoted-pair .app-heading{flex-wrap:wrap}.promoted-pair .app-heading h3{font-size:clamp(28px,3vw,42px);letter-spacing:-.025em}.promoted-pair .app-heading img{width:76px;height:76px;border-radius:22%;flex-shrink:0}
@media(max-width:760px){.spotlight{margin-top:16px}.spotlight-art{min-height:220px;margin:0 22px 24px}.spotlight-art>img{width:125px;height:125px}.quote-mark{font-size:320px;top:-20px}.cadence-beats{inset:15px}.promoted-pair .app-heading h3{font-size:clamp(25px,7vw,40px)}.promoted-pair .app-heading img{width:65px;height:65px}.promoted-pair .app-heading{gap:12px}}

/* Editorial artwork keeps transparent silhouettes, without app-icon tiles. */
.spotlight-art{padding:20px 28px 20px 0}
.spotlight-art>img{width:100%;max-width:420px;height:290px;object-fit:contain;border-radius:0;transform:none;box-shadow:none}
.promoted-pair .app-heading img{width:112px;height:112px;border-radius:0;transform:none}
@media(max-width:760px){.spotlight-art{padding:0;margin:0 24px 24px;min-height:220px}.spotlight-art>img{height:230px;max-width:360px}.promoted-pair .app-heading img{width:88px;height:88px}}
.nyah-project .app-heading img,.seek-project .app-heading img{width:112px;height:112px;flex-shrink:0;transform:none}
@media(max-width:760px){.nyah-project .app-heading img,.seek-project .app-heading img{width:88px;height:88px}.nyah-project .app-heading,.seek-project .app-heading{flex-wrap:wrap}}
</style>
