---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Navigation from '../components/Navigation.astro';
import bookSections from '../data/books.json';

---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Recommended Reads | Gavin Elliott" description="Books and articles recommended by Gavin Elliott" />
		<style>
			*, *::before, *::after {
				box-sizing: border-box;
			}
			
			html, body {
				overflow-x: hidden;
				width: 100%;
				margin: 0;
				padding: 0;
				position: relative;
			}
			
			main {
				padding-top: 5rem;
				background-color: #FFFFF8;
				min-height: 100vh;
				width: 100%;
				overflow-x: hidden;
			}
			
			.page-header {
				padding: 6rem 2rem 4rem;
				text-align: center;
				max-width: 800px;
				margin: 0 auto;
			}
			
			.page-header h1 {
				font-family: var(--font-ui);
				font-weight: 400;
				font-size: 4rem;
				color: #051005;
				margin-bottom: 1.5rem;
				line-height: 1;
			}
			
			.page-header p {
				font-family: var(--font-body);
				font-size: 1.35rem;
				line-height: 1.55;
				color: #051005;
				opacity: 0.8;
			}
			
			.content-container {
				max-width: 1200px;
				width: 100%;
				margin: 0 auto;
				padding: 0 2rem 4rem;
				font-family: var(--font-body);
				font-size: 1.35rem;
				line-height: 1.55;
				color: #051005;
				box-sizing: border-box;
			}
			
			.section-nav {
				margin: 2rem auto 4rem;
				max-width: 900px;
				width: calc(100% - 2rem);
				border-radius: 8px;
				background-color: rgba(144, 176, 144, 0.1);
				padding: 2rem;
				box-sizing: border-box;
			}
			
			.section-nav ul {
				list-style-type: none !important;
				display: flex;
				flex-wrap: wrap;
				gap: 1.5rem;
				padding: 0 !important;
				margin: 0 !important;
				justify-content: center;
				width: 100%;
			}
			
			.section-nav li {
				margin-bottom: 1.5rem;
				box-sizing: border-box;
			}
			
			.section-nav a {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				font-family: var(--font-ui);
				font-weight: 400;
				font-size: 1.2rem;
				border-radius: 8px;
				padding: 0.2rem 1.2rem 0.4rem;
				min-height: 2.8rem;
				background-color: rgba(144, 176, 144, 0.3);
				transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
				border: 1px solid rgba(144, 176, 144, 0.5);
				text-transform: uppercase;
				letter-spacing: 0.02em;
				line-height: 1.2;
				box-shadow: 0 2px 4px rgba(5, 16, 5, 0.05);
				position: relative;
				overflow: hidden;
				box-sizing: border-box;
			}
			
			.section-nav a:before {
				content: '';
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				background: radial-gradient(circle, rgba(255,255,255,0.2) 0%, rgba(255,255,255,0) 70%);
				opacity: 0;
				transform: scale(0.5);
				transition: opacity 0.4s ease, transform 0.4s ease;
			}
			
			.section-nav a:hover {
				background-color: rgba(144, 176, 144, 0.4);
				color: #051005;
				transform: translateY(-2px);
				box-shadow: 0 4px 8px rgba(5, 16, 5, 0.1);
			}
			
			.section-nav a:hover:before {
				opacity: 1;
				transform: scale(1.5);
			}
			
			.section-nav a:focus {
				outline: none;
				box-shadow: 0 0 0 3px rgba(144, 176, 144, 0.6), 0 4px 8px rgba(5, 16, 5, 0.1);
			}
			
			.section-nav a:active {
				transform: translateY(1px);
				box-shadow: 0 2px 3px rgba(5, 16, 5, 0.1);
				transition: all 0.1s;
			}
			
			@keyframes subtlePulse {
				0% { box-shadow: 0 2px 4px rgba(5, 16, 5, 0.05); }
				50% { box-shadow: 0 3px 6px rgba(5, 16, 5, 0.08); }
				100% { box-shadow: 0 2px 4px rgba(5, 16, 5, 0.05); }
			}
			
			.section-nav a:hover {
				animation: subtlePulse 2s infinite;
			}
			
            .book {
                padding-bottom: 2rem;
                border-bottom: 1px solid rgba(5, 16, 5, 0.1);
            }

            .book-details {
                display: flex;
                align-items: flex-start;
                gap: 1.5rem;
            }

            .book-cover {
                width: 120px;
                max-width: 25%;
                height: auto;
                flex-shrink: 0;
            }

            .book-description {
                min-width: 0;
            }

            .book-description p:first-child {
                margin-top: 0;
            }

            @media (max-width: 480px) {
                .book-details { flex-direction: column; }
                .book-cover { max-width: 100%; }
            }

			.reading-section {
				margin: 2em 0 4em;
				max-width: 900px;
				margin-left: auto;
				margin-right: auto;
			}
			
			.content-container h2 {
				font-family: var(--font-ui);
				font-weight: 400;
				font-size: 2.5rem;
				color: #051005;
				text-transform: uppercase;
				letter-spacing: 0.02em;
				line-height: 1;
				margin: 2em 0 1em 0;
			}
			
			.content-container h3 {
				font-family: var(--font-ui);
				font-weight: 400;
				font-size: 2rem;
				color: #051005;
				text-transform: uppercase;
				letter-spacing: 0.02em;
				line-height: 1.2;
				margin: 1.5em 0 0.8em;
			}
			
			.content-container a {
				color: #051005;
				text-decoration: none;
				background-image: linear-gradient(transparent calc(100% - 3px), rgba(144, 176, 144, 0.7) 3px);
				background-repeat: no-repeat;
				background-size: 100% 100%;
				padding-bottom: 0.1em;
				transition: background-image 0.3s ease;
			}
			
			.content-container a:hover {
				background-image: linear-gradient(transparent calc(100% - 3px), #90B090 3px);
			}
			
			.content-container .amazon-link {
				font-family: var(--font-ui);
				font-weight: 400;
				font-size: 1.1rem;
				letter-spacing: 0.02em;
				text-transform: uppercase;
			}
			
			.content-container ul {
				list-style-type: disc;
				padding-left: 1.5rem;
				margin: 1.5rem 0;
			}
			
			.content-container li {
				margin-bottom: 0.75rem;
			}
			
			hr {
				margin: 2em 0;
				border: none;
				border-top: 1px solid rgba(5, 16, 5, 0.1);
			}
			
			/* Skip to main content link for keyboard users */
			.skip-link {
				position: absolute;
				top: -40px;
				left: 0;
				background: #90B090;
				color: #051005;
				padding: 8px;
				z-index: 100;
				font-family: var(--font-ui);
			}

			.skip-link:focus {
				top: 0;
			}
			
			/* Ensure keyboard-only focus styles are visible */
			a:focus:not(:focus-visible) {
				outline: none;
			}
			
			/* High contrast mode improvements */
			@media (forced-colors: active) {
				.section-nav a:hover,
				.section-nav a:focus {
					border: 2px solid CanvasText;
				}
				
				.nav-items a:hover,
				.nav-items a:focus {
					border: 2px solid Canvas;
				}
			}
			
			@media (max-width: 1200px) {
				.content-container {
					padding: 0 1.5rem 3rem;
				}
			}
			
			@media (max-width: 1024px) {
				.page-header {
					padding: 5rem 2rem 3rem;
				}
				
				.page-header h1 {
					font-size: 3.5rem;
				}
				
				.content-container {
					font-size: 1.25rem;
				}
				
				.content-container h2 {
					font-size: 2.25rem;
				}
				
				.content-container h3 {
					font-size: 1.75rem;
				}
			}
			
			@media (max-width: 768px) {
				.page-header {
					padding: 4rem 1.5rem 3rem;
				}
				
				.page-header h1 {
					font-size: 3rem;
				}
				
				.page-header p {
					font-size: 1.25rem;
				}
				
				.content-container {
					padding: 0 1.25rem 2.5rem;
					font-size: 1.2rem;
				}
				
				.content-container h2 {
					font-size: 2rem;
				}
				
				.content-container h3 {
					font-size: 1.5rem;
				}
				
				.section-nav {
					margin: 2rem auto 3rem;
					padding: 1.5rem;
					width: calc(100% - 3rem);
				}
				
				.section-nav ul {
					flex-direction: column;
					gap: 0.5rem;
				}
				
				.section-nav li {
					margin-bottom: 0.5rem;
					width: 100%;
				}
				
				.section-nav a {
					display: flex;
					text-align: center;
					padding: 0.2rem 1.2rem 0.4rem;
					width: 100%;
				}
			}
			
			@media (max-width: 480px) {
				.page-header {
					padding: 3rem 1rem 2rem;
				}
				
				.page-header h1 {
					font-size: 2.5rem;
				}
				
				.page-header p {
					font-size: 1.15rem;
				}
				
				.content-container {
					padding: 0 1rem 2rem;
					font-size: 1.1rem;
					width: 100%;
					margin: 0 auto;
					box-sizing: border-box;
				}
				
				.content-container h2 {
					font-size: 1.8rem;
				}
				
				.content-container h3 {
					font-size: 1.4rem;
				}
				
				.section-nav {
					padding: 1.25rem 1rem;
					margin: 1.5rem auto 2.5rem;
					width: calc(100% - 2rem);
				}
				
				.reading-section {
					width: 100%;
					padding: 0 0.5rem;
					box-sizing: border-box;
				}
				
				.section-nav a {
					padding: 0.2rem 1.2rem 0.4rem;
					min-height: 2.5rem;
					width: 100%;
				}
			}
			
			.section-nav a:focus-visible {
				outline: 3px solid #90B090;
				outline-offset: 2px;
			}
		</style>
	</head>
	<body>
		<!-- Skip to content for accessibility -->
		<a href="#main-content" class="skip-link">Skip to main content</a>
	
		<!-- Main navigation bar -->
		<Navigation />
		
		<main id="main-content" tabindex="-1">
			<div class="page-header">
				<h1>READING</h1>
				<p>Books I've found valuable covering design leadership, product management, and business practices.</p>
			</div>
			
			<div class="content-container">
				<div class="section-nav">
					<nav aria-label="Content categories">
						<ul>
                            {bookSections.map((section) => (
                                <li><a href={`#${section.id}`}>{section.title}</a></li>
                            ))}
                        </ul>
					</nav>
				</div>
				
                <p class="affiliate-disclosure">These are affiliate links. If you buy through them, I may receive a small commission at no extra cost to you.</p>
                {bookSections.map((section) => (
                    <section id={section.id} class="reading-section" tabindex="-1" aria-labelledby={`${section.id}-heading`}>
                        <h2 id={`${section.id}-heading`}>{section.title}</h2>
                        <p>{section.intro}</p>
                        {section.books.map((book) => (
                            <article class="book">
                                <h3>{book.title}</h3>
                                <div class="book-details">
                                    <img class="book-cover" src={book.cover} alt={`${book.title} book cover`} width="120" loading="lazy" decoding="async" />
                                    <div class="book-description">
                                        {book.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
                                        <p><a href={book.url} class="amazon-link" rel="sponsored noopener" aria-label={`Buy ${book.title} on Amazon`}>BUY IT ON AMAZON</a></p>
                                    </div>
                                </div>
                            </article>
                        ))}
                    </section>
                ))}
			</div>
		</main>
		<Footer />
	</body>
</html>