---
import {getCollection} from 'astro:content';
import Layout from '../../components/newspaper/Layout.astro';
const projects=(await getCollection('shipped',({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<Layout title="Shipped projects | Gav Elliott" description="The archive of apps and projects I’ve built and shipped."><main id="main" tabindex="-1"><header><p class="eyebrow">The project archive</p><h1>Built & shipped.</h1><p><a href="/work/">See what I’m working on now →</a></p></header><section aria-label="Shipped projects">{projects.map(p=><article><h2><a href={`/shipped/${p.id}/`}>{p.data.title}</a></h2><p>{p.data.description}</p><p>{p.data.status} · {p.data.date.getUTCFullYear()}</p></article>)}</section></main></Layout>
<style>main{padding:35px 0}header{padding-bottom:30px;border-bottom:3px solid}h1{font:400 clamp(32px,6vw,80px)/1.4 var(--display);text-transform:uppercase}section{display:grid;grid-template-columns:1fr 1fr;gap:30px}article{padding:25px 0;border-bottom:1px solid var(--rule)}h2{font:700 25px/1.4 var(--ui);margin-bottom:15px}article p{margin:12px 0}@media(max-width:760px){section{grid-template-columns:1fr}}</style>
